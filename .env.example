# Required for hosted generation. Choose a current model from the AI Gateway catalog.
AI_MODEL=provider/model-id

# Local development only. Vercel deployments use the automatic VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=

# Required in production when hosted generation is enabled. Vercel's Upstash
# integration supplies these names; direct Upstash accounts use
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
